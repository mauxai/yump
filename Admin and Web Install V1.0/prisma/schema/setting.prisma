/// Key-value store for all app settings. Vertical EAV shape so new keys can be
/// added from the admin UI without schema changes. Group by `category` (tab).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.LongText
  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("settings")
}
